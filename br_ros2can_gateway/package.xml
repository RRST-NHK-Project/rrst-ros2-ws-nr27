<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>br_ros2can_gateway</name>
  <version>0.0.1</version>
  <description>
    BR の PC と ros2can の間に置く仲介ノードと、4輪独立ステアの逆運動学（dev_ws の決定事項58・60・68）。
    割り当て表と換算の純関数・逆運動学ノード・仲介ノード・ros2can の模擬と、その試験（SW-65・SW-66・SW-71）。
  </description>
  <maintainer email="Nzomu@users.noreply.github.com">Nzomu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
