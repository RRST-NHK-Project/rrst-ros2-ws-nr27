<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nr27_sensors</name>
  <version>0.0.0</version>
  <description>NR27 LiDAR bringup (LD19, YDLIDAR TG30, Hokuyo UST-30LX). Launch and config only.</description>
  <maintainer email="silby72@users.noreply.github.com">silby72</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ドライバは他のワークスペースに入っている (README の「ドライバ」参照) -->
  <exec_depend>ldlidar_component</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>urg_node2</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
